FROM node:16-alpine AS build-stage
WORKDIR /app
COPY code/example-frontend .

RUN npm install && \
    npm run build


FROM node:16-alpine

WORKDIR /app
COPY --from=build-stage /app/build/ .
EXPOSE 5001

RUN npm install -g serve && \
    adduser -D frontend && \
    chown frontend .

USER frontend
CMD serve -s -l 5001 build
