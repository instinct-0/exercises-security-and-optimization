FROM ubuntu:24.04

WORKDIR /frontend

EXPOSE 5001

COPY code/example-frontend .

RUN \
    apt update && \
    apt install -y curl && \
    curl -sL https://deb.nodesource.com/setup_16.x | bash && \
    apt install -y nodejs && \
    npm install && \
    useradd frontend && \
    chown frontend . && \
    REACT_APP_BACKEND_URL="http://localhost:8080/" npm run build && \
    npm install -g serve && \
    \
    apt-get purge -y --auto-remove curl && \
    rm -rf /var/lib/apt/lists/* example-frontend/src

USER frontend
CMD ["serve", "-s", "-l", "5001", "build"]
