FROM golang:1.16

WORKDIR /backend

EXPOSE 8080
ENV PORT=8080
ENV REQUEST_ORIGIN=http://localhost:5001

COPY code/example-backend .

RUN \
    go build && \
    go test ./... && \
    useradd backend && \
    chown backend . && \
    \
    rm -rf example-backend/cache
    
USER backend
CMD ["./server"]
